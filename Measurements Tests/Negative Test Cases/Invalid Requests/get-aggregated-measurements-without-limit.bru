meta {
  name: Get Aggregated Measurements Without Limit
  type: http
  seq: 1
}

get {
  url: {{url}}/measurements?appid={{APIKey}}&station_id=000000000000000000000000&type=m&from=0&to=4102444800
  body: none
  auth: none
}

params:query {
  appid: {{APIKey}}
  station_id: 000000000000000000000000
  type: m
  from: 0
  to: 4102444800
}

tests {
  test("Status code is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("Body has an error message", function () {
    expect(res.body.message).to.be.a("string").and.not.be.empty;
  });
}
