meta {
  name: Send a Measurement With Text Temperature
  type: http
  seq: 1
}

post {
  url: {{url}}/measurements?appid={{APIKey}}
  body: json
  auth: none
}

params:query {
  appid: {{APIKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  [
    {
      "station_id": "{{station_id}}",
      "dt": {{$timestamp}},
      "temperature": "warm",
      "wind_speed": 1.2,
      "wind_gust": 3.4,
      "pressure": 1021,
      "humidity": 87,
      "rain_1h": 2
    }
  ]
}

tests {
  test("Status code is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("Body contains message", function () {
    expect(JSON.stringify(res.body)).to.include("message");
  });
}
