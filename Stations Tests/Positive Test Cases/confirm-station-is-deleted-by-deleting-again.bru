meta {
  name: Confirm Station Is Deleted by Deleting Again
  type: http
  seq: 5
}

delete {
  url: {{url}}/stations/{{station_id}}?appid={{APIKey}}
  body: none
  auth: none
}

params:query {
  appid: {{APIKey}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 404", function () {
    expect(res.status).to.equal(404);
  });

  test("Body contains Station not found", function () {
    expect(JSON.stringify(res.body)).to.include("Station not found");
  });
}
