meta {
  name: Register a Weather Station
  type: http
  seq: 1
}

post {
  url: {{url}}/stations?appid={{APIKey}}
  body: json
  auth: none
}

params:query {
  appid: {{APIKey}}
}

body:json {
  {
    "external_id": "{{$randomUUID}}",
    "name": "{{$randomCity}} Test Station",
    "latitude": {{$randomLatitude}},
    "longitude": {{$randomLongitude}},
    "altitude": {{$randomInt}}
  }
}

script:post-response {
  if (res.body && res.body.ID) {
    bru.setEnvVar("station_id", res.body.ID);
    bru.setEnvVar("initial_station_name", res.body.name);
  } else {
    bru.runner.stopExecution();
  }
}

tests {
  test("Status code is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("Body contains updated_at", function () {
    expect(JSON.stringify(res.body)).to.include("updated_at");
  });

  test("Station ID is a non-empty string", function () {
    expect(res.body.ID).to.be.a("string").and.not.be.empty;
  });

  test("Station name ends with Test Station", function () {
    expect(res.body.name).to.match(/ Test Station$/);
  });

  test("Coordinates and altitude are numbers", function () {
    expect(res.body.latitude).to.be.a("number");
    expect(res.body.longitude).to.be.a("number");
    expect(res.body.altitude).to.be.a("number");
  });
}
