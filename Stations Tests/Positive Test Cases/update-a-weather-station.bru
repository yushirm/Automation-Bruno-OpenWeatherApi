meta {
  name: Update a Weather Station
  type: http
  seq: 4
}

put {
  url: {{url}}/stations/{{station_id}}?appid={{APIKey}}
  body: json
  auth: none
}

params:query {
  appid: {{APIKey}}
}

body:json {
  {
    "external_id": "{{$randomUUID}}",
    "name": "{{$randomCity}} Updated Test Station",
    "latitude": {{$randomLatitude}},
    "longitude": {{$randomLongitude}},
    "altitude": {{$randomInt}}
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Station name was changed", function () {
    expect(res.body.name).to.not.eql(bru.getEnvVar("initial_station_name"));
  });

  test("Updated station name ends with Test Station", function () {
    expect(res.body.name).to.match(/ Test Station$/);
  });
}
