meta {
  name: Get Aggregated Measurements
  type: http
  seq: 6
}

get {
  url: {{url}}/measurements?appid={{APIKey}}&station_id={{station_id}}&type=m&limit=100&from=0&to=4102444800
  body: none
  auth: none
}

params:query {
  appid: {{APIKey}}
  station_id: {{station_id}}
  type: m
  limit: 100
  from: 0
  to: 4102444800
}

script:pre-request {
  // The aggregate can lag behind the measurement sent just before.
  await bru.sleep(2000);
}

tests {
  test("Status code is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Body is a list of measurements", function () {
    expect(res.body).to.be.an("array");
  });

  test("List contains the measurement that was sent", function () {
    expect(res.body).to.have.length.above(0);
  });
}
