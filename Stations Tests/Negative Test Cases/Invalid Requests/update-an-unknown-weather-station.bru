meta {
  name: Update an Unknown Weather Station
  type: http
  seq: 2
}

put {
  url: {{url}}/stations/000000000000000000000000?appid={{APIKey}}
  body: json
  auth: none
}

params:query {
  appid: {{APIKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "external_id": "{{$randomUUID}}",
    "name": "{{$randomCity}} Test Station",
    "latitude": {{$randomLatitude}},
    "longitude": {{$randomLongitude}},
    "altitude": {{$randomInt}}
  }
}

tests {
  test("Status code is 404", function () {
    expect(res.status).to.equal(404);
  });

  test("Body contains message", function () {
    expect(JSON.stringify(res.body)).to.include("message");
  });
}
