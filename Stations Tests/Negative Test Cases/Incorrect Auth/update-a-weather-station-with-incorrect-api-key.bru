meta {
  name: Update a Weather Station With Incorrect API Key
  type: http
  seq: 3
}

put {
  url: {{url}}/stations/{{station_id}}?appid={{$randomUUID}}
  body: json
  auth: none
}

params:query {
  appid: {{$randomUUID}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "external_id": "{{$randomUUID}}",
    "name": "{{$randomCity}} Test Station",
    "latitude": {{$randomLatitude}},
    "longitude": {{$randomLongitude}},
    "altitude": {{$randomInt}}
  }
}

tests {
  test("Status code is 401", function () {
    expect(res.status).to.equal(401);
  });

  test("Body contains Invalid API key", function () {
    expect(JSON.stringify(res.body)).to.include("Invalid API key");
  });
}
